{
  "name": "claudeclaw",
  "version": "1.2.1",
  "description": "Your personal Claude Code assistant, delivered to your phone via Slack or Telegram",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc",
    "build:web": "vite build",
    "build:server": "tsc",
    "start": "node dist/index.js",
    "electron": "node scripts/run-electron.mjs .",
    "electron:dev": "npm run build && node scripts/run-electron.mjs .",
    "electron:build": "npm run build && electron-builder install-app-deps && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "status": "tsx scripts/status.ts",
    "agent:create": "bash scripts/agent-create.sh",
    "agent:start": "node dist/index.js --agent",
    "uninstall": "bash scripts/uninstall.sh",
    "build:warroom-client": "esbuild warroom/client.js --bundle --outfile=warroom/client.bundle.js --format=iife --global-name=PipecatWarRoom"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.34",
    "@google/genai": "^1.44.0",
    "@hono/node-server": "^1.19.9",
    "@monaco-editor/react": "^4.7.0",
    "@slack/bolt": "^4.7.3",
    "@slack/web-api": "^7.14.1",
    "@types/three": "^0.184.0",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "grammy": "^1.34.0",
    "hono": "^4.12.3",
    "js-yaml": "^4.1.1",
    "monaco-editor": "^0.55.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "three": "^0.184.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@pipecat-ai/client-js": "^1.7.0",
    "@pipecat-ai/websocket-transport": "^1.6.2",
    "@preact/preset-vite": "^2.10.5",
    "@preact/signals": "^2.9.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "^2.0.0",
    "dompurify": "^3.4.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "lucide-preact": "^1.14.0",
    "marked": "^18.0.2",
    "preact": "^10.29.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0",
    "wouter-preact": "^3.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "src/**/*.test.ts"
    ]
  },
  "build": {
    "appId": "com.claudeclaw.app",
    "productName": "ClaudeClaw",
    "afterSign": "build/notarize.cjs",
    "directories": {
      "output": "dist_electron"
    },
    "asar": false,
    "files": [
      "electron/**",
      "dist/**"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "dist/**",
          "agents/**",
          "warroom/**",
          "migrations/**",
          "package.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
